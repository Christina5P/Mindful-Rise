import os
import django

# --- Django setup ---
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'mindful_rise.settings')
django.setup()

from blog.models import Post, Category
from django.contrib.auth.models import User
from cloudinary.uploader import list_resources

def restore_posts_from_cloudinary():
    # Hämta första användaren som författare
    author = User.objects.first()
    if not author:
        print("Ingen användare finns. Skapa en användare först.")
        return

    # Hämta alla bilder från Cloudinary (ersätt 'votre_folder' om du har mappstruktur)
    resources = list_resources(type='upload')['resources']

    for res in resources:
        title = res['public_id']
        content = "Återskapat från Cloudinary."
        slug = title.replace("/", "-")  # ersätt ev. / i public_id

        # Hämta eller skapa inlägg
        post, created = Post.objects.get_or_create(
            title=title,
            defaults={
                "author": author,
                "content": content,
                "slug": slug,
            }
        )

        # Lägg till kategori (skapa om den inte finns)
        cat_name = "/".join(title.split("/")[:-1]) or "Uncategorized"
        category, _ = Category.objects.get_or_create(name=cat_name)
        post.categories.add(category)

        # Spara inlägget
        post.save()

        print(f"{'Skapade' if created else 'Återskapade'}: {title} under kategori {cat_name}")

if __name__ == "__main__":
    restore_posts_from_cloudinary()
